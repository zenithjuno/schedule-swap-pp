  "narrative": {
    "northStar": "Library wayfinding clarity",
    "overview": "This preview uses the clarity of school library signage: a deep teal navigation shell, pale teal ground and white work surfaces. Readable Thai sans text and quiet boundaries keep dates, people and caveats available for comparison. There is no library ornament or new raster imagery.\n\nThis is the implemented Set A system in preview/index.html, derived from its final previewUxA screen overrides and inherited controls. It covers the preview shell, entry view and comparison workspace. The stable root index.html retains its existing visual system. Set A is a partial overhaul: later simulation, communication documents and status changes are not implemented by this design record; existing legacy routes can retain older treatments.",
    "keyCharacteristics": [
      "Deep teal wayfinding with pale teal and white working surfaces.",
      "Desktop comparison first; compact, labeled reading blocks on mobile.",
      "Explicit proposal selection with a lower summary in normal document flow.",
      "Flat panels, visible keyboard focus and restrained state changes."
    ],
    "rules": [
      {
        "name": "The Wayfinding Rule",
        "body": "Use the deep teal shell to orient the user; keep comparison content on light surfaces with dark text.",
        "section": "colors"
      },
      {
        "name": "The Reading Rule",
        "body": "Use the Thai workhorse sans stack for the screen interface and retain TH Sarabun New for document and timetable paper surfaces.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use tonal grouping and boundaries for the new workspace panels; do not add card shadows to these panels.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep actual dates and caveats visible beside each candidate’s selection action.",
      "Do retain labeled mobile comparison fields, visible focus and explicit selected states.",
      "Do keep the selected-proposal summary in document flow below the workspace.",
      "Do preserve TH Sarabun New on printed document surfaces."
    ],
    "donts": [
      "Don't apply this preview system to the protected stable root page.",
      "Don't turn previewing, opening details or printing into an approval action.",
      "Don't add ornamental library illustrations, new raster decoration or synthetic personal data.",
      "Don't treat legacy typography, glyph decoration or later unbuilt flows as newly approved design rules."
    ]
  }
}
